.block {
  margin-top: 24rpx;
}

.segmented {
  display: flex;
}

.seg {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #a7b5aa;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.seg + .seg {
  margin-left: 16rpx;
}

.seg.active {
  color: #101710;
  font-weight: 700;
  background: #d8ff4a;
  border-color: #d8ff4a;
}

.input {
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #e9f2ea;
}

.input-ph {
  color: #5f6f65;
}

.url-actions {
  display: flex;
  margin-top: 20rpx;
}

.url-actions .btn-ghost + .btn-ghost {
  margin-left: 14rpx;
}

.url-actions .btn-ghost {
  height: 76rpx;
  font-size: 24rpx;
}

.server-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #25e0a5;
}

.field-hint {
  margin-top: 18rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6d7d72;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-text {
  flex: 1;
  padding-right: 20rpx;
}

.setting-name {
  font-size: 28rpx;
  color: #eef6ef;
}

.setting-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8a80;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #a7b5aa;
  line-height: 1.6;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 16rpx 0 4rpx;
  border-radius: 50%;
  background: #25e0a5;
  flex-shrink: 0;
}

.about-row {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: #9fb0a4;
}
