.hero {
  padding: 16rpx 8rpx 8rpx;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #d8ff4a;
  text-transform: uppercase;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #f2f8f3;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b8a80;
}

.block {
  margin-top: 24rpx;
}

.stroke-list {
  display: flex;
  flex-direction: column;
}

.stroke-option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  margin-bottom: 16rpx;
}

.stroke-option:last-child {
  margin-bottom: 0;
}

.stroke-option.active {
  background: rgba(216, 255, 74, 0.08);
  border-color: rgba(216, 255, 74, 0.55);
}

.stroke-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.stroke-option.active .stroke-radio {
  border-color: #d8ff4a;
}

.stroke-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: transparent;
}

.stroke-option.active .stroke-dot {
  background: #d8ff4a;
}

.stroke-text {
  flex: 1;
}

.stroke-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #eef6ef;
}

.stroke-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8a80;
}

.hint {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(37, 224, 165, 0.07);
  color: #9fd8bd;
  font-size: 24rpx;
  line-height: 1.6;
}

.uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 32rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(216, 255, 74, 0.25);
  background: rgba(216, 255, 74, 0.03);
}

.uploader-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(216, 255, 74, 0.12);
  color: #d8ff4a;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.uploader-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #7b8a80;
  text-align: center;
}

.upload-actions {
  display: flex;
  width: 100%;
  margin-top: 28rpx;
}

.upload-actions .btn-ghost {
  margin-right: 20rpx;
}

.upload-actions .btn-ghost:last-child {
  margin-right: 0;
}

.preview {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  background: #000;
}

.analyze-btn {
  margin-top: 28rpx;
}

.progress {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #25e0a5, #d8ff4a);
  transition: width 0.2s linear;
}

.demo-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffb547;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #a7b5aa;
  line-height: 1.6;
}

.tip-row:last-child {
  margin-bottom: 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 16rpx 0 4rpx;
  border-radius: 50%;
  background: #25e0a5;
  flex-shrink: 0;
}

.link {
  color: #d8ff4a;
}

.recent-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.recent-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.recent-date {
  width: 110rpx;
  font-size: 24rpx;
  color: #7b8a80;
}

.recent-stroke {
  flex: 1;
  font-size: 26rpx;
  color: #cfdad1;
}

.recent-score {
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.recent-grade {
  width: 96rpx;
  text-align: right;
  font-size: 22rpx;
  color: #7b8a80;
}
