/* 全局主题：与「羽姿」网页版/安卓版保持一致的深色运动风格 */

page {
  background: #070b08;
  color: #e9f2ea;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page-wrap {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  background: #101710;
  border: 1rpx solid rgba(216, 255, 74, 0.08);
  border-radius: 28rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #eef6ef;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #7b8a80;
}

.muted {
  color: #7b8a80;
}

.accent {
  color: #d8ff4a;
}

.mint {
  color: #25e0a5;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn-reset {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border: none;
  font-size: inherit;
  color: inherit;
}

.btn-reset::after {
  border: none;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #d8ff4a, #b6f23c);
  color: #101710;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
  color: #101710;
  background: linear-gradient(135deg, #d8ff4a, #b6f23c);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #e9f2ea;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost::after {
  border: none;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(216, 255, 74, 0.12);
  color: #d8ff4a;
}

.pill.warn {
  background: rgba(255, 181, 71, 0.14);
  color: #ffb547;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.07);
  margin: 24rpx 0;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
